---
/**
 * 메인 페이지. 구성: CLAUDE.md 10장 (샘플/데모 섹션은 운영자 결정으로 보류)
 */
import AiAnswerExample from '@/components/AiAnswerExample.astro';
import Citation from '@/components/sections/Citation.astro';
import Faq from '@/components/sections/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Guides from '@/components/sections/Guides.astro';
import Hero from '@/components/sections/Hero.astro';
import Industries from '@/components/sections/Industries.astro';
import IntroVideo from '@/components/sections/IntroVideo.astro';
import Problem from '@/components/sections/Problem.astro';
import Process from '@/components/sections/Process.astro';
import dinoMagnifier from '@/assets/characters/dino-magnifier.webp';
import { siteConfig } from '@/config/site';
import { mainFaq } from '@/data/faq';
import { hero, introVideo, problem } from '@/data/home';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { faqSchema, videoSchema } from '@/lib/schema';
---

<BaseLayout
  title={`AI 검색(GEO) 노출 진단 — 변호사·세무사·학원·인테리어 | ${siteConfig.name}`}
  description="ChatGPT·Gemini 같은 AI에 우리 비즈니스가 나오는지 무료로 진단하고, AI 검색 최적화(GEO)로 필요한 것만 정리합니다."
  fullTitle
  schema={[
    faqSchema(mainFaq),
    videoSchema({
      name: introVideo.name,
      description: introVideo.description,
      thumbnailPath: introVideo.poster,
      contentPath: introVideo.src,
      uploadDate: introVideo.uploadDate,
      durationISO: introVideo.durationISO,
    }),
  ]}
>
  <Hero
    eyebrow={hero.eyebrow}
    titleLines={hero.titleLines}
    highlight={hero.highlight}
    lead={hero.lead}
    note={hero.note}
    subLink={{ label: introVideo.linkLabel, href: `#${introVideo.id}` }}
  >
    <AiAnswerExample slot="visual" />
  </Hero>
  <IntroVideo />
  <Problem
    eyebrow={problem.eyebrow}
    title={problem.title}
    lead={problem.lead}
    quotes={problem.quotes}
    image={{ src: dinoMagnifier, alt: '돋보기로 무언가를 살펴보는 초록 공룡' }}
  />
  <Citation />
  <Process />
  <Industries />
  <Guides />
  <Faq items={mainFaq} />
  <FinalCta />
</BaseLayout>
