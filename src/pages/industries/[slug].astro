---
/**
 * 업종 랜딩 페이지 템플릿. 내용은 src/content/industries/<slug>.md 에서 온다.
 * 구성: CLAUDE.md 9장 (진행 방식 섹션은 운영자 결정으로 제외. 완성 예시는 example이 있는 업종만)
 */
import AiQuestions from '@/components/sections/AiQuestions.astro';
import ExampleSite from '@/components/sections/ExampleSite.astro';
import Faq from '@/components/sections/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Guides from '@/components/sections/Guides.astro';
import Hero from '@/components/sections/Hero.astro';
import Organize from '@/components/sections/Organize.astro';
import Problem from '@/components/sections/Problem.astro';
import WhyNow from '@/components/sections/WhyNow.astro';
import { getIndustries, industryHref, type IndustryEntry } from '@/data/industries';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema, faqSchema, industryServiceSchema, type BreadcrumbItem } from '@/lib/schema';

export async function getStaticPaths() {
  const industries = await getIndustries();
  return industries.map((industry) => ({
    params: { slug: industry.id },
    props: { industry },
  }));
}

interface Props {
  industry: IndustryEntry;
}

const { industry } = Astro.props;
const { name, seo, hero, problem, questions, whyNow, organize, faqs, finalCta, example } = industry.data;
const path = industryHref(industry);

// 홈 > 업종 랜딩 2단계 (CLAUDE.md 4.1). 업종 목록 페이지가 없으므로 중간 단계를 두지 않는다.
const breadcrumbs: BreadcrumbItem[] = [
  { name: '홈', path: '/' },
  { name, path },
];
const schema = [
  breadcrumbSchema(breadcrumbs),
  industryServiceSchema({ name: `${name} AI 검색 노출 진단`, description: seo.description, path, audience: name }),
  faqSchema(faqs),
];
---

<BaseLayout title={seo.title} description={seo.description} industry={industry.id} schema={schema}>
  <Hero
    titleLines={hero.titleLines}
    lead={hero.lead}
    image={hero.image}
    imageAlt={hero.imageAlt}
    titleSize="compact"
    breadcrumbs={breadcrumbs}
  />
  <Problem title={problem.title} lead={problem.lead} quotes={problem.quotes} />
  <AiQuestions title={questions.title} lead={questions.lead} items={questions.items} />
  <WhyNow title={whyNow.title} paragraphs={whyNow.paragraphs} />
  <Organize title={organize.title} lead={organize.lead} items={organize.items} />
  {example && <ExampleSite {...example} />}
  <Faq items={faqs} />
  <Guides />
  <FinalCta title={finalCta.title} lead={finalCta.lead} />
</BaseLayout>
