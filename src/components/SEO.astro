---
/**
 * 페이지별 메타데이터: title, description, canonical, Open Graph, Twitter card, JSON-LD.
 * title·description은 페이지마다 고유하게 넣는다 (CLAUDE.md 11장).
 */
import { siteConfig } from '@/config/site';
import { absoluteUrl, type JsonLd } from '@/lib/schema';

export interface Props {
  title: string;
  description: string;
  /** true면 "| GeoDino" 접미사를 붙이지 않는다 (메인 페이지 등) */
  fullTitle?: boolean;
  ogImage?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: JsonLd[];
}

const {
  title,
  description,
  fullTitle = false,
  ogImage = siteConfig.ogImage,
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url).href;
const ogImageUrl = absoluteUrl(ogImage.src);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImage.alt} />

{schema.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
