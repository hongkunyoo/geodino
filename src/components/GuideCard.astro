---
import { formatDate, guideHref, type GuideEntry } from '@/data/guides';

export interface Props {
  guide: GuideEntry;
  headingLevel?: 'h2' | 'h3';
}

const { guide, headingLevel = 'h3' } = Astro.props;
const { title, description, updatedAt } = guide.data;
const Heading = headingLevel;
---

<article class="guide-card">
  <Heading class="guide-card__title">
    <a href={guideHref(guide)}>{title}</a>
  </Heading>
  <p class="guide-card__desc">{description}</p>
  <p class="guide-card__meta">
    <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time> 수정
  </p>
</article>

<style>
  .guide-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-thin);
    border-left: 4px solid var(--color-green-400);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .guide-card__title {
    font-size: var(--text-lg);
  }

  .guide-card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* 카드 전체를 클릭 영역으로 */
  .guide-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .guide-card:has(a:hover) .guide-card__title a,
  .guide-card:has(a:focus-visible) .guide-card__title a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .guide-card:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .guide-card__title a:focus-visible {
    outline: none;
  }

  .guide-card__desc {
    color: var(--color-ink-muted);
  }

  .guide-card__meta {
    margin-top: auto;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
