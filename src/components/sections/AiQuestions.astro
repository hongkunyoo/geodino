---
/**
 * 손님이 AI에게 묻는 질문 (업종별 검색 의도). 말풍선 형태로 보여준다.
 */
import SectionHeader from '@/components/SectionHeader.astro';

export interface Props {
  title: string;
  lead: string;
  items: { category: string; question: string }[];
}

const { title, lead, items } = Astro.props;
---

<section class="section" aria-labelledby="questions-title">
  <div class="container">
    <SectionHeader id="questions-title" eyebrow="손님이 AI에게 묻는 질문" title={title} lead={lead} />
    <ul class="questions">
      {
        items.map((item) => (
          <li class="questions__item">
            <span class="questions__category">{item.category}</span>
            <p class="questions__bubble">“{item.question}”</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .questions {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .questions__item {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-2);
  }

  .questions__category {
    justify-self: start;
    padding: 2px var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-green-50);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .questions__bubble {
    padding: var(--space-4) var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-md) var(--radius-md) var(--radius-md) 4px;
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 768px) {
    .questions {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .questions {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
