---
/**
 * 업종에 맞춰 정리하는 내용 (처방 목록)
 */
import SectionHeader from '@/components/SectionHeader.astro';

export interface Props {
  title: string;
  lead: string;
  items: { title: string; description: string }[];
}

const { title, lead, items } = Astro.props;
---

<section class="section" aria-labelledby="organize-title">
  <div class="container">
    <SectionHeader id="organize-title" eyebrow="정리하는 내용" title={title} lead={lead} />
    <ul class="organize">
      {
        items.map((item) => (
          <li class="organize__item">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .organize {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .organize__item {
    padding: var(--space-5);
    border: var(--border-thin);
    border-left: 4px solid var(--color-green-400);
    border-radius: var(--radius-md);
  }

  .organize__item h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .organize__item p {
    color: var(--color-ink-muted);
  }

  @media (min-width: 768px) {
    .organize {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
