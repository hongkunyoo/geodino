---
import { Image } from 'astro:assets';
import platformHub from '@/assets/guides/platform-hub.webp';
import SectionHeader from '@/components/SectionHeader.astro';
import { citation } from '@/data/home';

const { example } = citation;
---

<section class="section" aria-labelledby="citation-title">
  <div class="container">
    <SectionHeader id="citation-title" eyebrow={citation.eyebrow} title={citation.title} lead={citation.lead} />
    <ol class="citation__list">
      {
        citation.conditions.map((condition, i) => (
          <li class="citation__card">
            <span class="citation__num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{condition.title}</h3>
            <p>{condition.description}</p>
          </li>
        ))
      }
    </ol>

    <figure class="citation__example">
      <Image
        class="citation__example-art"
        src={platformHub}
        alt={example.imageAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 860px) 440px, 100vw"
      />
      <figcaption class="citation__example-text">
        <h3>{example.title}</h3>
        <p>{example.body}</p>
        <a href={example.link.href}>{example.link.label} →</a>
      </figcaption>
    </figure>

    <p class="citation__closing">{citation.closing}</p>
  </div>
</section>

<style>
  .citation__list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .citation__card {
    padding: var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-md);
  }

  .citation__num {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--color-green-100);
    color: var(--color-green-800);
    font-weight: var(--font-weight-bold);
  }

  .citation__card h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .citation__card p {
    color: var(--color-ink-muted);
  }

  .citation__example {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    margin: var(--space-6) 0 0;
    padding: var(--space-5);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .citation__example-art {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  .citation__example-text h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .citation__example-text p {
    margin-bottom: var(--space-3);
    color: var(--color-ink-muted);
  }

  .citation__example-text a {
    font-weight: var(--font-weight-semibold);
  }

  .citation__closing {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 860px) {
    .citation__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .citation__example {
      grid-template-columns: minmax(0, 440px) 1fr;
      gap: var(--space-6);
      padding: var(--space-6);
    }
  }
</style>
